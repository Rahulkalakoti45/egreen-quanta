# Backend-local overrides. The repo-root .env is also read (root takes lower priority).
# For dev you normally need nothing here — defaults in app/core/config.py are dev-safe.

# APP_ENV=dev
# DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# SECRET_KEY=dev-only-insecure-change-me-32bytes-minimum
# LOG_JSON=false
# ML_ENABLED=false
