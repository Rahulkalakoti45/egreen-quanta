# Frontend build-time config (Vite). Copy to .env for local overrides.

# API base. Default uses the Vite dev-server proxy, so leave unset for local dev.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Where the dev-server proxy forwards /api (defaults to http://localhost:8000).
# VITE_PROXY_TARGET=http://localhost:8000
